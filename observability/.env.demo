# Source with:  set -a; . observability/.env.demo; set +a; npm start
# Synthetic metrics — no SSH / nvidia-smi needed.
SPARKDASH_DEMO=1
SPARKS_JSON_PATH=./observability/demo/sparks.json
SETTINGS_JSON_PATH=./observability/demo/settings.json
LLM_DAILY_JSON_PATH=./observability/demo/llm-daily.json
# Reachable from the Docker network (Prometheus scrapes host.docker.internal:5555)
BIND_HOST=0.0.0.0
PORT=5555
# Prometheus pull — on by default
PROMETHEUS_METRICS=1
# InfluxDB push (matches observability/docker-compose.yml)
INFLUX_URL=http://localhost:8086
INFLUX_ORG=sparkdash
INFLUX_BUCKET=sparkdash
INFLUX_TOKEN=sparkdash-dev-token
INFLUX_INTERVAL_MS=5000

# sparkDash observability mini-stack: Prometheus (pull) + InfluxDB 2 (push) + Grafana.
#
#   cd observability
#   docker compose up -d
#   # then run sparkDash on the host with exporters enabled (see ../docs/OBSERVABILITY.md)
#
# Grafana     http://localhost:3000   (admin / sparkdash)
# Prometheus  http://localhost:9090
# InfluxDB    http://localhost:8086   (admin / sparkdash123, org=sparkdash, bucket=sparkdash, token below)
#
# The Prometheus target defaults to host.docker.internal:5555 — sparkDash on
# this Docker host. Edit prometheus/prometheus.yml for a remote deployment.
name: sparkdash-observability

services:
  prometheus:
    image: prom/prometheus:v3.5.0
    container_name: sparkdash-prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.retention.time=180d
      - --web.enable-lifecycle
    ports:
      - "127.0.0.1:9090:9090"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prom-data:/prometheus
    restart: unless-stopped

  influxdb:
    image: influxdb:2.7
    container_name: sparkdash-influxdb
    ports:
      - "8086:8086"
    environment:
      DOCKER_INFLUXDB_INIT_MODE: setup
      DOCKER_INFLUXDB_INIT_USERNAME: admin
      DOCKER_INFLUXDB_INIT_PASSWORD: sparkdash123
      DOCKER_INFLUXDB_INIT_ORG: sparkdash
      DOCKER_INFLUXDB_INIT_BUCKET: sparkdash
      DOCKER_INFLUXDB_INIT_RETENTION: 180d   # applied at first setup only; existing bucket changed via API
      DOCKER_INFLUXDB_INIT_ADMIN_TOKEN: ${INFLUX_TOKEN:-sparkdash-dev-token}
    volumes:
      - influx-data:/var/lib/influxdb2
    restart: unless-stopped

  grafana:
    image: grafana/grafana:11.6.0
    container_name: sparkdash-grafana
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: sparkdash
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_DASHBOARDS_MIN_REFRESH_INTERVAL: 15s
      INFLUX_TOKEN: ${INFLUX_TOKEN:-sparkdash-dev-token}
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
    depends_on:
      - prometheus
      - influxdb
    restart: unless-stopped

volumes:
  prom-data:
  influx-data:
  grafana-data:

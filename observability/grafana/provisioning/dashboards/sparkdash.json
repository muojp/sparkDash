    {
      "id": 16,
      "type": "timeseries",
      "title": "RDMA / RoCE throughput (ConnectX-7 IB counters — TP traffic; invisible to /proc/net/dev) — 1m avg",
      "datasource": {
        "type": "prometheus",
        "uid": "sparkdash-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (spark, name, hca) (8 * rate(sparkdash_rdma_receive_bytes_total{spark=~\"$spark\"}[1m]) > 0)",
          "legendFormat": "{{name}} {{hca}} rx"
        },
        {
          "refId": "B",
          "expr": "max by (spark, name, hca) (8 * rate(sparkdash_rdma_transmit_bytes_total{spark=~\"$spark\"}[1m]) > 0)",
          "legendFormat": "{{name}} {{hca}} tx"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "RDMA link probe — throughput (ib_write_bw 2 s / 30 min, both directions, idle only; single QP RC) vs 1m avg",
      "datasource": {
        "type": "prometheus",
        "uid": "sparkdash-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* 1m avg$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }

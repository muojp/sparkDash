      "fieldConfig": {
        "defaults": {
          "unit": "suffix: k",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 3,
            "showPoints": "auto",
            "lineInterpolation": "linear",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* prefill$"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"

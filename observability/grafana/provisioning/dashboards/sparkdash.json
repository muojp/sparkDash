        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "System power",
      "datasource": {
        "type": "prometheus",
        "uid": "sparkdash-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"

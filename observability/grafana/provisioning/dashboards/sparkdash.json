{
  "uid": "sparkdash-overview",
  "title": "sparkDash — Fleet overview",
  "tags": [
    "sparkdash",
    "dgx-spark"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "spark",
        "label": "Unit",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sparkdash-prom"
        },
        "query": {
          "query": "label_values(sparkdash_up, spark)",
          "refId": "v"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Fleet",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Online",
      "datasource": {
        "type": "prometheus",
        "uid": "sparkdash-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (spark, name) (sparkdash_up{spark=~\"$spark\"})",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GPU temp",
      "datasource": {
        "type": "prometheus",
        "uid": "sparkdash-prom"

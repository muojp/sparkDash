    {
      "id": 35,
      "type": "stat",
      "title": "RDMA link (active ports)",
      "datasource": {
        "type": "prometheus",
        "uid": "sparkdash-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sparkdash_rdma_link_speed_mbps{spark=~\"$spark\"} and on(spark,hca,port) sparkdash_rdma_port_active == 1, \"hca\", \"$1\", \"hca\", \"roce(.*)\")",
          "legendFormat": "{{name}} {{hca}}",
          "instant": true
        }
      ]
    },

        {
          "refId": "A",
          "expr": "max by (spark, name, port) ((sparkdash_llm_output_tokens_total{spark=~\"$spark\"} or (last_over_time(sparkdash_llm_output_tokens_total{spark=~\"$spark\"}[$__range] @ end()) and (max_over_time(timestamp(sparkdash_llm_output_tokens_total{spark=~\"$spark\"})[$__range:5m] @ end()) <= time()))) / 1000)",

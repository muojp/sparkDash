        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (spark, name) (sparkdash_gpu_temperature_celsius{spark=~\"$spark\"})",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
